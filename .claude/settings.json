{
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Read",
      "EnterWorktree",
      "ExitWorktree",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff check src tests scripts)",
      "Bash(uv run autotester doctor)",
      "Bash(powershell -ExecutionPolicy Bypass -File scripts/append_decision.ps1 *)",
      "Bash(python D:/ai_os/scripts/delegate_unit.py *)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(ssh:*)",
      "Bash(chmod 777:*)",
      "Bash(chmod -R 777:*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf $HOME/*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh release delete:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File qa/hooks/mc-sessionstart.ps1"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/lab-session-start.ps1",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File qa/hooks/mc-precommit.ps1"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/decisions-append-guard.ps1"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/lab-session-end.ps1",
            "timeout": 10
          }
        ]
      }
    ]
  }
}