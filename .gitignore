# Credentials — never committed, under any project
**/.env
**/.env.*
!**/.env.example

# Persistent browser profiles hold live logged-in sessions
profiles/

# Scratch, evidence, logs. Nothing here is a deliverable.
.work/

# Playwright MCP tool scratch (screenshots/console logs from live browser sessions)
.playwright-mcp/

# Pre-compact session handoff notes -- ephemeral, session-scoped, not project state
.handoffs/

# Run artifacts: screenshots and traces may contain product data
projects/*/runs/

# Lazily-generated default rubrics (stages/run_case_pipeline.py) -- derived
# state, same as runs/, not a deliverable to hand-commit per project
projects/*/rubrics/

# Video chunks and extracted frames (host-side media prep, Track A/D-014) --
# large binary derived state, regenerable from the registered source
projects/*/sources/*/chunks/
projects/*/sources/*/frames/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# OS
Thumbs.db
.DS_Store

# Crawl artifacts: screenshots of a real product under test
projects/*/crawl/*/shots/
