{"type":"tool_use","timestamp":1790056952200,"sessionID":"ses_f384abf6fffeFUfA0TJNj3z8bv","part":{"type":"tool","tool":"read","callID":"call_fd3fsxtg","state":{"status":"completed","input":{"filePath":"D:\\autoTesting\\.worktrees\\at119-vocab\\tests\\test_goal_criticality_vocabulary.py"},"output":"<path>D:\\autoTesting\\.worktrees\\at119-vocab\\tests\\test_goal_criticality_vocabulary.py</path>\n<type>file</type>\n<content>\n1: \"\"\"`.goal/goal.json`'s criticality vocabulary must match the classifier's.\n2: \n3: AT-116 (checker-found): the shared classifier keys its ordering off the\n4: lowercase set below and falls back to `\"low\"` for anything it does not\n5: recognise â€” case-sensitively. This project wrote `\"HIGH\"`, `\"CRITICAL\"`,\n6: `\"NORMAL\"` â€¦ from the day the file was created, so **every** task's declared\n7: floor was silently discarded and 41 of 44 rows derived `low`. Nothing failed;\n8: the field simply never did anything.\n9: \n10: That is the failure mode this test exists for: a config value that is read,\n11: not rejected, and quietly ignored. It cannot be caught by the classifier\n12: (which has no way to know `\"HIGH\"` was meant to be `\"high\"`) so it is pinned\n13: here, on the data.\n14: \"\"\"\n15: \n16: from __future__ import annotations\n17: \n18: import importlib.util\n19: import json\n20: from pathlib import Path\n21: \n22: import pytest\n23: \n24: GOAL = Path(__file__).resolve().parents[1] / \".goal\" / \"goal.json\"\n25: \n26: CLASSIFIER_SOURCE = Path(\"D:/ai_os/.claude/skills/goal/scripts/criticality.py\")\n27: \n28: # Mirrors `goal/scripts/criticality.py::_ORDER`. Duplicated deliberately: that\n29: # file is a shared AIOS skill outside this repo, so importing it would make this\n30: # project's test suite depend on a path it does not own.\n31: CLASSIFIER_VOCABULARY = {\"low\", \"medium\", \"high\", \"critical\"}\n32: \n33: \n34: def tasks() -> list[dict]:\n35:     return json.loads(GOAL.read_text(encoding=\"utf-8\"))[\"tasks\"]\n36: \n37: \n38: def test_every_base_criticality_is_a_value_the_classifier_recognises() -> None:\n39:     \"\"\"The whole of AT-116 in one assertion. A value outside this set is not a\n40:     validation error anywhere â€” it is silently downgraded to the lowest floor.\"\"\"\n41:     unknown = {\n42:         t[\"id\"]: t[\"base_criticality\"]\n43:         for t in tasks()\n44:         if t.get(\"base_criticality\") not in CLASSIFIER_VOCABULARY\n45:     }\n46:     assert not unknown, (\n47:         \"these tasks declare a criticality the classifier will silently ignore, \"\n48:         f\"downgrading them to 'low': {unknown}\"\n49:     )\n50: \n51: \n52: def test_the_highest_risk_pending_work_actually_derives_critical() -> None:\n53:     \"\"\"The consequence that made AT-116 worth fixing rather than noting: a\n54:     `critical` task gets a DUAL check (two blind checkers, both must pass).\n55:     While the vocabulary mismatch stood, T-145 â€” an autonomous crawler pointed\n56:     at a live production ERP â€” derived `low` and would have got a single one.\"\"\"\n57:     by_id = {t[\"id\"]: t for t in tasks()}\n58:     for task_id in (\"T-145\", \"T-154\"):\n59:         assert by_id[task_id].get(\"criticality\") == \"critical\", (\n60:             f\"{task_id} derives {by_id[task_id].get('criticality')!r}, not 'critical' â€” \"\n61:             \"it would be dispatched to a single checker\"\n62:         )\n63: \n64: \n65: def test_the_deliberate_copy_has_not_drifted_from_its_source() -> None:\n66:     \"\"\"The copy above is only safe if it still mirrors the source. If the shared\n67:     `_ORDER` ever changes, every assertion in this file keeps passing against a\n68:     stale set â€” the same silent divergence AT-116 was. Skips when the source\n69:     checkout is absent, so this suite stays green without it.\"\"\"\n70:     if not CLASSIFIER_SOURCE.exists():\n71:         pytest.skip(f\"shared classifier not present at {CLASSIFIER_SOURCE}\")\n72: \n73:     spec = importlib.util.spec_from_file_location(\n74:         \"criticality_source\", CLASSIFIER_SOURCE\n75:     )\n76:     if spec is None or spec.loader is None:\n77:         pytest.skip(f\"cannot load shared classifier from {CLASSIFIER_SOURCE}\")\n78: \n79:     criticality = importlib.util.module_from_spec(spec)\n80:     try:\n81:         spec.loader.exec_module(criticality)\n82:     except Exception as exc:\n83:         pytest.skip(f\"cannot import shared classifier from {CLASSIFIER_SOURCE}: {exc}\")\n84: \n85:     source_vocabulary = set(criticality._ORDER)\n86:     assert CLASSIFIER_VOCABULARY == source_vocabulary, (\n87:         \"this file's copy of the classifier vocabulary has drifted from the \"\n88:         f\"source at {CLASSIFIER_SOURCE}: local copy={CLASSIFIER_VOCABULARY}, \"\n89:         f\"source={source_vocabulary}\"\n90:     )\n\n(End of file - total 90 lines)\n</content>","metadata":{"preview":"\"\"\"`.goal/goal.json`'s criticality vocabulary must match the classifier's.\n\nAT-116 (checker-found): the shared classifier keys its ordering off the\nlowercase set below and falls back to `\"low\"` for anything it does not\nrecognise â€” case-sensitively. This project wrote `\"HIGH\"`, `\"CRITICAL\"`,\n`\"NORMAL\"` â€¦ from the day the file was created, so **every** task's declared\nfloor was silently discarded and 41 of 44 rows derived `low`. Nothing failed;\nthe field simply never did anything.\n\nThat is the failure mode this test exists for: a config value that is read,\nnot rejected, and quietly ignored. It cannot be caught by the classifier\n(which has no way to know `\"HIGH\"` was meant to be `\"high\"`) so it is pinned\nhere, on the data.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport importlib.util\nimport json\nfrom pathlib import Path","truncated":false,"loaded":[],"display":{"type":"file","path":"D:\\autoTesting\\.worktrees\\at119-vocab\\tests\\test_goal_criticality_vocabulary.py","text":"\"\"\"`.goal/goal.json`'s criticality vocabulary must match the classifier's.\n\nAT-116 (checker-found): the shared classifier keys its ordering off the\nlowercase set below and falls back to `\"low\"` for anything it does not\nrecognise â€” case-sensitively. This project wrote `\"HIGH\"`, `\"CRITICAL\"`,\n`\"NORMAL\"` â€¦ from the day the file was created, so **every** task's declared\nfloor was silently discarded and 41 of 44 rows derived `low`. Nothing failed;\nthe field simply never did anything.\n\nThat is the failure mode this test exists for: a config value that is read,\nnot rejected, and quietly ignored. It cannot be caught by the classifier\n(which has no way to know `\"HIGH\"` was meant to be `\"high\"`) so it is pinned\nhere, on the data.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport importlib.util\nimport json\nfrom pathlib import Path\n\nimport pytest\n\nGOAL = Path(__file__).resolve().parents[1] / \".goal\" / \"goal.json\"\n\nCLASSIFIER_SOURCE = Path(\"D:/ai_os/.claude/skills/goal/scripts/criticality.py\")\n\n# Mirrors `goal/scripts/criticality.py::_ORDER`. Duplicated deliberately: that\n# file is a shared AIOS skill outside this repo, so importing it would make this\n# project's test suite depend on a path it does not own.\nCLASSIFIER_VOCABULARY = {\"low\", \"medium\", \"high\", \"critical\"}\n\n\ndef tasks() -> list[dict]:\n    return json.loads(GOAL.read_text(encoding=\"utf-8\"))[\"tasks\"]\n\n\ndef test_every_base_criticality_is_a_value_the_classifier_recognises() -> None:\n    \"\"\"The whole of AT-116 in one assertion. A value outside this set is not a\n    validation error anywhere â€” it is silently downgraded to the lowest floor.\"\"\"\n    unknown = {\n        t[\"id\"]: t[\"base_criticality\"]\n        for t in tasks()\n        if t.get(\"base_criticality\") not in CLASSIFIER_VOCABULARY\n    }\n    assert not unknown, (\n        \"these tasks declare a criticality the classifier will silently ignore, \"\n        f\"downgrading them to 'low': {unknown}\"\n    )\n\n\ndef test_the_highest_risk_pending_work_actually_derives_critical() -> None:\n    \"\"\"The consequence that made AT-116 worth fixing rather than noting: a\n    `critical` task gets a DUAL check (two blind checkers, both must pass).\n    While the vocabulary mismatch stood, T-145 â€” an autonomous crawler pointed\n    at a live production ERP â€” derived `low` and would have got a single one.\"\"\"\n    by_id = {t[\"id\"]: t for t in tasks()}\n    for task_id in (\"T-145\", \"T-154\"):\n        assert by_id[task_id].get(\"criticality\") == \"critical\", (\n            f\"{task_id} derives {by_id[task_id].get('criticality')!r}, not 'critical' â€” \"\n            \"it would be dispatched to a single checker\"\n        )\n\n\ndef test_the_deliberate_copy_has_not_drifted_from_its_source() -> None:\n    \"\"\"The copy above is only safe if it still mirrors the source. If the shared\n    `_ORDER` ever changes, every assertion in this file keeps passing against a\n    stale set â€” the same silent divergence AT-116 was. Skips when the source\n    checkout is absent, so this suite stays green without it.\"\"\"\n    if not CLASSIFIER_SOURCE.exists():\n        pytest.skip(f\"shared classifier not present at {CLASSIFIER_SOURCE}\")\n\n    spec = importlib.util.spec_from_file_location(\n        \"criticality_source\", CLASSIFIER_SOURCE\n    )\n    if spec is None or spec.loader is None:\n        pytest.skip(f\"cannot load shared classifier from {CLASSIFIER_SOURCE}\")\n\n    criticality = importlib.util.module_from_spec(spec)\n    try:\n        spec.loader.exec_module(criticality)\n    except Exception as exc:\n        pytest.skip(f\"cannot import shared classifier from {CLASSIFIER_SOURCE}: {exc}\")\n\n    source_vocabulary = set(criticality._ORDER)\n    assert CLASSIFIER_VOCABULARY == source_vocabulary, (\n        \"this file's copy of the classifier vocabulary has drifted from the \"\n        f\"source at {CLASSIFIER_SOURCE}: local copy={CLASSIFIER_VOCABULARY}, \"\n        f\"source={source_vocabulary}\"\n    )","lineStart":1,"lineEnd":90,"totalLines":90,"truncated":false}},"title":"tests\\test_goal_criticality_vocabulary.py","time":{"start":1790056951971,"end":1790056952173}},"id":"prt_0c7b57078001E14HoQH97wyhr5","sessionID":"ses_f384abf6fffeFUfA0TJNj3z8bv","messageID":"msg_0c7b55501001x6gOLmMfcxsLCX"}}
